local enabled = false
local taskHandles = {}

local function showNotification(message, state)
    local notif = Instance.new("TextLabel", screenGui)
    notif.Size = UDim2.new(0.65, 0, 0, 45)
    notif.Position = UDim2.new(0.5, 0, 0.12, 0)
    notif.AnchorPoint = Vector2.new(0.5, 0)
    notif.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    notif.Text = message .. (state and " ENABLED ✅" or " DISABLED ❌")
    notif.TextColor3 = state and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
    notif.TextScaled = true
    notif.Font = Enum.Font.GothamBold
    Instance.new("UICorner", notif)
    
    game:GetService("TweenService"):Create(notif, TweenInfo.new(2.8), {Position = UDim2.new(0.5, 0, 0.04, 0), BackgroundTransparency = 1, TextTransparency = 1}):Play()
    game:GetService("Debris"):AddItem(notif, 3)
end

local function autoPunchFeature(state)
    showNotification("Auto Punch + Rings", state)
    if state then
        taskHandles.punch = task.spawn(function()
            local mainKeys = ReplicatedStorage:WaitForChild("events"):WaitForChild("MainKeys")
            while true do pcall(function() mainKeys:FireServer("Punch") end) task.wait(0.25) end
        end)
        taskHandles.rings = task.spawn(function()
            local mainKeys = ReplicatedStorage:WaitForChild("events"):WaitForChild("MainKeys")
            while true do pcall(function() mainKeys:FireServer("Rings") end) task.wait(0.4) end
        end)
    else
        if taskHandles.punch then task.cancel(taskHandles.punch) taskHandles.punch = nil end
        if taskHandles.rings then task.cancel(taskHandles.rings) taskHandles.rings = nil end
    end
end

-- Toggle
toggleButton.MouseButton1Click:Connect(function()
    enabled = not enabled
    if enabled then
        toggleButton.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
        toggleButton.Text = "ON"
        statusLabel.Text = "Status: Enabled"
    else
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        toggleButton.Text = "OFF"
        statusLabel.Text = "Status: Disabled"
    end
    autoPunchFeature(enabled)
end)

-- Minimize / Hide
minimizeButton.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
    floatButton.Visible = true
end)

-- Show from floating button
floatButton.MouseButton1Click:Connect(function()
    mainFrame.Visible = true
    floatButton.Visible = false
end)

-- PC Hotkey
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        enabled = not enabled
        if enabled then
            toggleButton.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
            toggleButton.Text = "ON"
            statusLabel.Text = "Status: Enabled"
        else
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
            toggleButton.Text = "OFF"
            statusLabel.Text = "Status: Disabled"
        end
        autoPunchFeature(enabled)
    end
end)

print("✅ Auto Punch + Rings GUI Loaded | RightShift to toggle | Tap – to hide")
